{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmechanica.local/schemas/q08_evidence_block_bootstrap_v1.schema.json",
  "title": "Q08 Evidence Moving-Block Bootstrap v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method",
    "source_axis_sha256",
    "source_panel_sha256",
    "source_axis_length",
    "seed",
    "block_length",
    "sample_length",
    "replicate_count",
    "paths"
  ],
  "properties": {
    "schema_version": {"const": "q08_evidence_block_bootstrap/v1"},
    "method": {"const": "MOVING_BLOCK"},
    "source_axis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_panel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_axis_length": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "block_length": {"type": "integer", "minimum": 2},
    "sample_length": {"type": "integer", "minimum": 1},
    "replicate_count": {"type": "integer", "minimum": 1},
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["replicate", "source_indices", "sleeves"],
        "properties": {
          "replicate": {"type": "integer", "minimum": 0},
          "source_indices": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0}
          },
          "sleeves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sleeve_id", "returns"],
              "properties": {
                "sleeve_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "returns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "number"}
                }
              }
            }
          }
        }
      }
    }
  }
}
