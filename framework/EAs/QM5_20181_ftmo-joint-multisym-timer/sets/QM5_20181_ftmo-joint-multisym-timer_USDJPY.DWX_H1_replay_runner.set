;==========================================================
; QM5 Set File — SINGLETON REPLAY (runner sleeve 0 only) — fidelity control
; ea_id:        20181
; ea_slug:      ftmo-joint-multisym-timer
; purpose:      run ONLY the runner (sleeve 0 = QM5_9936:USDJPY) so its Q08
;               TRADE_CLOSED stream can be diffed trade-for-trade against a
;               freshly-compiled standalone QM5_9936 run on the SAME terminal /
;               framework vintage (compare_joint_replay.py, match_rate == 1.0).
; environment:  backtest (BACKTEST-ONLY instrument)
; host_symbol:  USDJPY.DWX
; NOTE: news inputs (qm_news_temporal/qm_news_compliance) are LEFT AT THE EA
;       DEFAULTS (PRE30_POST30 + DXZ) — exactly as 9936's gated backtest set,
;       which also sets no FW1 news inputs. Do NOT add them here.
;==========================================================
qm_ea_id=20181
qm_magic_slot_offset=0
qm_evidence_run_id=FTMO_BOOK3_20260729_V1_J0
RISK_FIXED=1000
RISK_PERCENT=0
PORTFOLIO_WEIGHT=1
qm_risk_cap_pct=1.0
qm_stress_reject_probability=0.0
host_symbol=USDJPY.DWX
; --- Sleeve 0 : RUNNER — QM5_9936 gated backtest params (range 01-06, cancel 13, close 20) ---
s0_enabled=1
s0_symbol=USDJPY.DWX
s0_risk_fixed=1000
s0_range_start_hr=1
s0_range_end_hr=6
s0_cancel_hr=13
s0_close_hr=20
s0_atr_period=14
s0_min_range_atr_mult=0.4
s0_max_range_atr_mult=2.5
s0_trail_trigger_r=1.0
s0_range_scan_bars=36
; --- Sleeve 1 : SATELLITE-1 (XAUUSD) — DISABLED in step 1 (wired in step 2) ---
s1_enabled=0
s1_symbol=XAUUSD.DWX
s1_risk_fixed=1000
; --- Sleeve 2 : SATELLITE-2 (13108:XTIUSD) — DISABLED in runner control ---
s2_enabled=0
