{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantmechanica.com/schemas/strategy-archive/v3.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "$schema_id",
    "generated_at",
    "gate_contract_version",
    "disclosure",
    "total",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1"
    },
    "$schema_id": {
      "const": "https://quantmechanica.com/schemas/strategy-archive/v3.1.json"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate_contract_version": {
      "const": "v4"
    },
    "disclosure": {
      "const": "named_gate_journey_without_metrics"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_id",
          "slug",
          "display_name",
          "tagline",
          "family",
          "review_status",
          "markets",
          "first_tested",
          "last_updated",
          "terminal_status",
          "evidence_scope",
          "gate_journey",
          "revision_history"
        ],
        "properties": {
          "public_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^strategy_[0-9a-f]{16}$"
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z]+(?:-[a-z]+)*-[0-9a-f]{6}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^0-9]*$"
          },
          "tagline": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^0-9]*$"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^0-9]*$"
          },
          "review_status": {
            "const": "OWNER_CEO_REVIEW_REQUIRED"
          },
          "markets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol_public",
                "timeframe"
              ],
              "properties": {
                "symbol_public": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Z][A-Z0-9]{2,9}$"
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:M[1-9][0-9]?|H[1-9][0-9]?|D1|W1|MN1|multi|UNKNOWN)$"
                }
              }
            }
          },
          "first_tested": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "last_updated": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "terminal_status": {
            "enum": [
              "research frontier",
              "optimization",
              "book candidate",
              "retired"
            ]
          },
          "evidence_scope": {
            "const": "Historical evidence; current release and live operation require separate verification."
          },
          "gate_journey": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "name",
                "gates"
              ],
              "properties": {
                "phase": {
                  "enum": [
                    "validation",
                    "optimization",
                    "book"
                  ]
                },
                "name": {
                  "enum": [
                    "Validation",
                    "Optimization and requalification",
                    "Book build and live readiness"
                  ]
                },
                "gates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "gate",
                      "purpose",
                      "outcome",
                      "passed_symbols",
                      "failed_symbols",
                      "backtests"
                    ],
                    "properties": {
                      "gate": {
                        "enum": [
                          "Q00",
                          "Q01",
                          "Q02",
                          "Q03",
                          "Q04",
                          "Q05",
                          "Q06",
                          "Q07",
                          "Q08",
                          "Q09",
                          "Q10",
                          "Q11",
                          "Q12",
                          "Q13",
                          "Q14",
                          "Q15",
                          "Q16",
                          "Q17"
                        ]
                      },
                      "purpose": {
                        "enum": [
                          "Reviews whether a strategy source and its extracted ideas are ready to enter the validation pipeline.",
                          "Confirms that the trading system builds correctly and that its mechanical specification is complete before backtesting.",
                          "Screens whether the strategy produces a meaningful, profitable signal across its intended markets before deeper validation.",
                          "Tests whether the result persists across a stable parameter neighbourhood rather than depending on a single tuned setting.",
                          "Uses walk-forward testing with a realistic venue cost model to check whether the strategy generalises beyond development data.",
                          "Replays robust parameters across the full available history to test whether the edge persists across market regimes.",
                          "Applies execution stress to test whether the strategy remains reliable when fills are disrupted.",
                          "Repeats the test across multiple random seeds to distinguish a genuine signal from lucky execution ordering.",
                          "Combines statistical and robustness checks into a target-neutral evidence dossier for the frozen baseline.",
                          "Freezes a full-history pre-news baseline as the reference for the later sealed comparison.",
                          "Uses controlled news-condition comparisons to select a news mode and assess venue compliance.",
                          "Confirms the locked configuration over full history with realistic costs and the selected news mode.",
                          "Evaluates preregistered pattern filters while allowing the unfiltered strategy to remain the valid choice.",
                          "Optimises numerical parameters on development data and freezes the selected configuration for independent comparison.",
                          "Compares the frozen challenger with its baseline and incumbent to decide whether to promote it or keep the incumbent.",
                          "Evaluates correlation, tail behaviour, clustering, marginal contribution and fit within an authorised portfolio.",
                          "Runs the operational pre-flight that must pass before an approved portfolio can proceed toward deployment.",
                          "Observes the approved strategy in live burn-in under monitoring and kill-switch controls before full live use."
                        ]
                      },
                      "outcome": {
                        "enum": [
                          "passed",
                          "failed",
                          "mixed"
                        ]
                      },
                      "passed_symbols": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[A-Z][A-Z0-9]{2,9}$"
                        }
                      },
                      "failed_symbols": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[A-Z][A-Z0-9]{2,9}$"
                        }
                      },
                      "backtests": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "symbol_public",
                            "timeframe",
                            "verdict"
                          ],
                          "properties": {
                            "symbol_public": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^[A-Z][A-Z0-9]{2,9}$"
                            },
                            "timeframe": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(?:M[1-9][0-9]?|H[1-9][0-9]?|D1|W1|MN1|multi|UNKNOWN)$"
                            },
                            "verdict": {
                              "enum": [
                                "PASS",
                                "FAIL"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "revision_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "public_id",
                "recorded_at"
              ],
              "properties": {
                "public_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^card_[0-9a-f]{16}$"
                },
                "recorded_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                }
              }
            }
          }
        }
      }
    }
  }
}
