{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmechanica.com/schemas/public-snapshot/v1.json",
  "title": "QuantMechanica Public Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "phase",
    "agents",
    "pipeline",
    "public_archive",
    "pipeline_gates",
    "t6",
    "expenses"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string"
    },
    "agents": {
      "type": "object",
      "required": ["online", "offline", "blocked"],
      "properties": {
        "online": { "type": "integer", "minimum": 0 },
        "offline": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": ["strategy_cards", "eas_built", "by_phase", "by_gate_v4"],
      "properties": {
        "strategy_cards": { "type": "integer", "minimum": 0 },
        "eas_built": { "type": "integer", "minimum": 0 },
        "by_phase": {
          "type": "object",
          "required": [
            "gate_contract_version",
            "G0",
            "P1",
            "P2",
            "P3",
            "P3_5",
            "P4",
            "P5",
            "P5b",
            "P5c",
            "P6",
            "P7",
            "P8",
            "P9",
            "P9b",
            "P10"
          ],
          "properties": {
            "gate_contract_version": { "type": "string", "const": "legacy-p-frozen/v1" },
            "G0": { "type": "integer", "minimum": 0 },
            "P1": { "type": "integer", "minimum": 0 },
            "P2": { "type": "integer", "minimum": 0 },
            "P3": { "type": "integer", "minimum": 0 },
            "P3_5": { "type": "integer", "minimum": 0 },
            "P4": { "type": "integer", "minimum": 0 },
            "P5": { "type": "integer", "minimum": 0 },
            "P5b": { "type": "integer", "minimum": 0 },
            "P5c": { "type": "integer", "minimum": 0 },
            "P6": { "type": "integer", "minimum": 0 },
            "P7": { "type": "integer", "minimum": 0 },
            "P8": { "type": "integer", "minimum": 0 },
            "P9": { "type": "integer", "minimum": 0 },
            "P9b": { "type": "integer", "minimum": 0 },
            "P10": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "by_gate_v4": {
          "type": "object",
          "required": [
            "gate_contract_version",
            "Q00", "Q01", "Q02", "Q03", "Q04", "Q05", "Q06", "Q07", "Q08",
            "Q09", "Q10", "Q11", "Q12", "Q13", "Q14", "Q15", "Q16", "Q17"
          ],
          "properties": {
            "gate_contract_version": { "type": "string", "const": "v4" },
            "Q00": { "type": "integer", "minimum": 0 },
            "Q01": { "type": "integer", "minimum": 0 },
            "Q02": { "type": "integer", "minimum": 0 },
            "Q03": { "type": "integer", "minimum": 0 },
            "Q04": { "type": "integer", "minimum": 0 },
            "Q05": { "type": "integer", "minimum": 0 },
            "Q06": { "type": "integer", "minimum": 0 },
            "Q07": { "type": "integer", "minimum": 0 },
            "Q08": { "type": "integer", "minimum": 0 },
            "Q09": { "type": "integer", "minimum": 0 },
            "Q10": { "type": "integer", "minimum": 0 },
            "Q11": { "type": "integer", "minimum": 0 },
            "Q12": { "type": "integer", "minimum": 0 },
            "Q13": { "type": "integer", "minimum": 0 },
            "Q14": { "type": "integer", "minimum": 0 },
            "Q15": { "type": "integer", "minimum": 0 },
            "Q16": { "type": "integer", "minimum": 0 },
            "Q17": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "public_archive": {
      "type": "object",
      "required": ["gate_contract_version", "progress_metric", "gates", "cards"],
      "properties": {
        "gate_contract_version": { "type": "string", "const": "v4" },
        "progress_metric": { "type": "string", "const": "highest_contiguous_valid_gate" },
        "gates": {
          "type": "array",
          "prefixItems": [
            { "const": "Q00" }, { "const": "Q01" }, { "const": "Q02" },
            { "const": "Q03" }, { "const": "Q04" }, { "const": "Q05" },
            { "const": "Q06" }, { "const": "Q07" }, { "const": "Q08" },
            { "const": "Q09" }, { "const": "Q10" }, { "const": "Q11" },
            { "const": "Q12" }, { "const": "Q13" }, { "const": "Q14" },
            { "const": "Q15" }, { "const": "Q16" }, { "const": "Q17" }
          ],
          "items": false,
          "minItems": 18,
          "maxItems": 18
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["public_id", "gates"],
            "properties": {
              "public_id": { "type": "string", "pattern": "^card_[0-9a-f]{16}$" },
              "mechanism_class": {
                "type": "string",
                "minLength": 1,
                "maxLength": 320,
                "pattern": "^[^0-9]+[.!?]$"
              },
              "gates": {
                "type": "object",
                "required": [
                  "Q00", "Q01", "Q02", "Q03", "Q04", "Q05", "Q06", "Q07", "Q08",
                  "Q09", "Q10", "Q11", "Q12", "Q13", "Q14", "Q15", "Q16", "Q17"
                ],
                "properties": {
                  "Q00": { "$ref": "#/$defs/public_gate_state" },
                  "Q01": { "$ref": "#/$defs/public_gate_state" },
                  "Q02": { "$ref": "#/$defs/public_gate_state" },
                  "Q03": { "$ref": "#/$defs/public_gate_state" },
                  "Q04": { "$ref": "#/$defs/public_gate_state" },
                  "Q05": { "$ref": "#/$defs/public_gate_state" },
                  "Q06": { "$ref": "#/$defs/public_gate_state" },
                  "Q07": { "$ref": "#/$defs/public_gate_state" },
                  "Q08": { "$ref": "#/$defs/public_gate_state" },
                  "Q09": { "$ref": "#/$defs/public_gate_state" },
                  "Q10": { "$ref": "#/$defs/public_gate_state" },
                  "Q11": { "$ref": "#/$defs/public_gate_state" },
                  "Q12": { "$ref": "#/$defs/public_gate_state" },
                  "Q13": { "$ref": "#/$defs/public_gate_state" },
                  "Q14": { "$ref": "#/$defs/public_gate_state" },
                  "Q15": { "$ref": "#/$defs/public_gate_state" },
                  "Q16": { "$ref": "#/$defs/public_gate_state" },
                  "Q17": { "$ref": "#/$defs/public_gate_state" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "pipeline_gates": {
      "type": "object",
      "required": ["gate_contract_version", "macro_phases", "gates"],
      "properties": {
        "gate_contract_version": { "type": "string", "const": "v4" },
        "macro_phases": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "const": "STRATEGY_PROOF" },
                "name": { "const": "Strategy proves itself" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "const": "OPTIMISATION_REQUALIFICATION" },
                "name": { "const": "Strategy is optimised and requalified" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "const": "PORTFOLIO_ASSESSMENT" },
                "name": { "const": "Strategy is assessed for the portfolio" }
              },
              "additionalProperties": false
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "gates": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {
            "type": "object",
            "required": ["id", "name", "macro_phase", "purpose"],
            "properties": {
              "id": { "type": "string", "pattern": "^Q(?:0[0-9]|1[0-7])$" },
              "name": { "type": "string", "minLength": 1, "pattern": "^[^0-9]+$" },
              "macro_phase": {
                "type": "string",
                "enum": [
                  "STRATEGY_PROOF",
                  "OPTIMISATION_REQUALIFICATION",
                  "PORTFOLIO_ASSESSMENT"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 320,
                "pattern": "^[^0-9]+[.!?]$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "t6": {
      "type": "object",
      "required": ["status", "autotrading", "risk_state"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["offline", "demo", "live", "degraded"]
        },
        "autotrading": { "type": "boolean" },
        "risk_state": {
          "type": "string",
          "enum": ["green", "yellow", "red"]
        }
      },
      "additionalProperties": false
    },
    "expenses": {
      "type": "object",
      "required": ["spent_eur", "budget_eur", "entries"],
      "properties": {
        "spent_eur": { "type": "number", "minimum": 0 },
        "budget_eur": { "type": "number", "minimum": 0 },
        "entries": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "public_gate_state": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNTESTED", "IN_PROGRESS"]
    }
  },
  "additionalProperties": false
}
