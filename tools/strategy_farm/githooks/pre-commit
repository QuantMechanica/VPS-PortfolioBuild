#!/bin/sh
# Tracked source for .git/hooks/pre-commit. Fail-closed guard: refuse commits
# that stage framework/EAs/**/*.ex5 changes without a governed COMPILE_EA
# receipt. See tools/strategy_farm/validate_ex5_commit_guard.py for the check
# and docs/ops/evidence/2026-08-24_ex5_commit_guard.md for the incident this
# closes. Installed into the shared .git/hooks/ dir (worktrees read hooks from
# there), so it applies to every worktree checkout.
#
# Fail-closed: if this hook cannot run python at all, the commit is blocked
# rather than silently skipped.

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
exec python "$REPO_ROOT/tools/strategy_farm/validate_ex5_commit_guard.py" --repo-root "$REPO_ROOT"
