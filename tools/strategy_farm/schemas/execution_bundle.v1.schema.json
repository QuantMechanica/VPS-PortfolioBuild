{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qm.execution-bundle/v1",
  "title": "QuantMechanica immutable execution bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "git",
    "strategy_card",
    "source",
    "tester",
    "rulepack",
    "bundle_id"
  ],
  "properties": {
    "schema_version": {"const": "qm.execution-bundle/v1"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/gitObject"},
        "tree_sha": {"$ref": "#/$defs/gitObject"}
      }
    },
    "strategy_card": {"$ref": "#/$defs/artifact"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mq5", "include_tree", "ex5"],
      "properties": {
        "mq5": {"$ref": "#/$defs/artifact"},
        "include_tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_path", "tree_sha256", "files"],
          "properties": {
            "root_path": {"$ref": "#/$defs/logicalPath"},
            "tree_sha256": {"$ref": "#/$defs/sha256"},
            "files": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/artifact"}
            }
          }
        },
        "ex5": {"$ref": "#/$defs/artifact"}
      }
    },
    "tester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setfile",
        "effective_inputs",
        "compiler",
        "terminal",
        "symbol_spec_snapshot",
        "history_snapshot",
        "cost_model",
        "calendar_bundle"
      ],
      "properties": {
        "setfile": {"$ref": "#/$defs/artifact"},
        "effective_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameters", "sha256"],
          "properties": {
            "parameters": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "value": {"type": "string"}
                }
              }
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "compiler": {"$ref": "#/$defs/toolBuild"},
        "terminal": {"$ref": "#/$defs/toolBuild"},
        "symbol_spec_snapshot": {"$ref": "#/$defs/artifact"},
        "history_snapshot": {"$ref": "#/$defs/artifact"},
        "cost_model": {"$ref": "#/$defs/artifact"},
        "calendar_bundle": {"$ref": "#/$defs/artifact"}
      }
    },
    "rulepack": {"$ref": "#/$defs/versionedArtifact"},
    "bundle_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).*[^/]$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/logicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/logicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "version", "binary"],
      "properties": {
        "build": {"type": "integer", "minimum": 1},
        "version": {"type": "string", "minLength": 1},
        "binary": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
