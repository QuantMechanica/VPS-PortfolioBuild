{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qm.factory-runtime-activation-owner-decision/v1",
  "title": "QuantMechanica Factory Runtime Activation OWNER Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "activation_nonce",
    "authority",
    "status",
    "authorized_at_utc",
    "expires_at_utc",
    "preparation_decision",
    "authorizations",
    "restart_holds",
    "worker_policy",
    "restore_intent",
    "source_bindings"
  ],
  "properties": {
    "schema_version": { "const": "qm.factory-runtime-activation-owner-decision/v1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "activation_nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "authority": { "const": "OWNER" },
    "status": { "const": "APPROVED" },
    "authorized_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expires_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "preparation_decision": {
      "const": {
        "relative_path": "docs/ops/evidence/2026-07-30_factory_preparation_owner_decision.json",
        "sha256": "af8479fdc73163250f966014eca5c53224a4ae159426a07cf96c80a379c6edb2",
        "git_commit": "7b36ff27f83f024bf1c43bb5537cc747f52b887a",
        "git_blob": "6d36cf6682e317324a35bc8388042402b0f3e540"
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory_on", "release_seven_restart_holds", "runtime_flag_upgrade_authorized"],
      "properties": {
        "factory_on": { "const": true },
        "release_seven_restart_holds": { "const": true },
        "runtime_flag_upgrade_authorized": { "const": false }
      }
    },
    "restart_holds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_release_count", "authorized_work_item_ids"],
      "properties": {
        "authorized_release_count": { "const": 7 },
        "authorized_work_item_ids": {
          "const": [
            "3746e558-6eff-436b-9365-cfec9b7f1a63",
            "ded31f32-92fb-45a7-b318-aa00c2f3f41c",
            "4bd848eb-d744-4f97-9a30-8323f0925394",
            "5c788bbb-cf26-4f6d-ac86-35bd869c5893",
            "d3c2c5ad-9455-4241-b30c-a9cb9260a4b5",
            "36bfac85-63e2-46a7-9f35-8ae583252d2f",
            "ad1aaca6-e639-4680-94c7-5108902438d2"
          ]
        }
      }
    },
    "worker_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disabled_terminals", "expected_worker_count", "expected_terminals"],
      "properties": {
        "disabled_terminals": { "const": ["T5"] },
        "expected_worker_count": { "const": 9 },
        "expected_terminals": {
          "const": ["T1", "T2", "T3", "T4", "T6", "T7", "T8", "T9", "T10"]
        }
      }
    },
    "restore_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory_off_flag_sha256", "factory_off_schema_version", "factory_off_state", "task_enabled_before_sha256"],
      "properties": {
        "factory_off_flag_sha256": { "$ref": "#/$defs/sha256" },
        "factory_off_schema_version": { "const": 2 },
        "factory_off_state": { "const": "OFF" },
        "task_enabled_before_sha256": {
          "const": "ccfb16110aa5722fdbc72bec361c180a485ae14afe2f3c1c99a9949301e0297f"
        }
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory_on", "factory_off", "maintenance_control", "runtime_activation_validator", "restart_health", "process_scope", "mutation_lock_protocol", "task_manifest", "worker_launcher", "farmctl"],
      "properties": {
        "factory_on": { "$ref": "#/$defs/fileBinding" },
        "factory_off": { "$ref": "#/$defs/fileBinding" },
        "maintenance_control": { "$ref": "#/$defs/fileBinding" },
        "runtime_activation_validator": { "$ref": "#/$defs/fileBinding" },
        "restart_health": { "$ref": "#/$defs/fileBinding" },
        "process_scope": { "$ref": "#/$defs/fileBinding" },
        "mutation_lock_protocol": { "$ref": "#/$defs/fileBinding" },
        "task_manifest": { "$ref": "#/$defs/fileBinding" },
        "worker_launcher": { "$ref": "#/$defs/fileBinding" },
        "farmctl": { "$ref": "#/$defs/fileBinding" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "git_commit", "git_blob"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "git_commit": { "$ref": "#/$defs/gitOid" },
        "git_blob": { "$ref": "#/$defs/gitOid" }
      }
    }
  }
}
